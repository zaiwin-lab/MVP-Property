generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Partner {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  whatsapp     String
  photo        String?
  bio          String?
  isActive     Boolean       @default(true)
  email        String?       @unique
  passwordHash String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  leads        Lead[]
  introducers  Introducer[]
  appointments Appointment[]
}

model Introducer {
  id           String   @id @default(cuid())
  partnerId    String
  name         String
  referralCode String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id])
  leads        Lead[]
}

model Apartment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String?
  videoUrl    String?
  location    String?
  priceFrom   String?
  highlights  String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id           String       @id @default(cuid())
  partnerId    String
  introducerId String?
  name         String
  phone        String
  email        String?
  apartment    String?
  budget       String?
  purpose      String?
  message      String?
  status       LeadStatus   @default(NEW)
  source       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  partner      Partner      @relation(fields: [partnerId], references: [id])
  introducer   Introducer?  @relation(fields: [introducerId], references: [id])
  appointment  Appointment?
}

model Appointment {
  id            String            @id @default(cuid())
  leadId        String            @unique
  partnerId     String
  preferredDate String
  preferredTime String
  purpose       String?
  status        AppointmentStatus @default(NEW)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lead          Lead              @relation(fields: [leadId], references: [id])
  partner       Partner           @relation(fields: [partnerId], references: [id])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT_SET
  VIEWING_COMPLETED
  CONVERTED
  LOST
}

enum AppointmentStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}
